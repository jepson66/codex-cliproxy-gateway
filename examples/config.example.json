{
  "schema_version": 1,
  "listen": "127.0.0.1:8765",
  "allow_non_loopback": false,
  "official_base_url": "https://chatgpt.com/backend-api/codex",
  "cliproxy_base_url": "http://127.0.0.1:8317/v1",
  "cliproxy_api_key_env": "CLIPROXY_API_KEY",
  "cliproxy_api_key_file": "~/.codex/codex-cliproxy-gateway/cliproxy-api-key",
  "cliproxy_config_path": "~/.cli-proxy-api/config.yaml",
  "zstd_command": "",
  "model_prefix": "cliproxy/",
  "codex_home": "~/.codex",
  "official_models_cache": "~/.codex/models_cache.json",
  "model_catalog_path": "~/.codex/model-catalogs/codex-cliproxy-gateway.json",
  "providers": [
    {
      "id": "kimi-code",
      "display_name": "Kimi Code",
      "setup_url": "https://www.kimi.com/code",
      "setup_hint": "Alternatively, keep using a Kimi Code API key by adding it to the local CLIProxyAPI config yourself.",
      "required_model": "kimi-k3"
    }
  ],
  "models": [
    {
      "id": "kimi-k3",
      "display_name": "Kimi K3",
      "description": "Kimi K3 via Kimi Code and CLIProxyAPI; 1M context requires an eligible membership",
      "provider_id": "kimi-code",
      "route": "cliproxy",
      "upstream_model": "kimi-k3",
      "wire_api": "responses",
      "context_window": 1048576,
      "input_modalities": ["text", "image"],
      "output_modalities": ["text"],
      "reasoning_levels": ["low", "high", "max"],
      "default_reasoning_level": "high",
      "reasoning_wire_format": "kimi-thinking",
      "capabilities": {
        "streaming": true,
        "tools": true,
        "parallel_tools": false,
        "web_search": false
      },
      "compatibility": {
        "status": "experimental",
        "cliproxyapi": "7.3.11"
      }
    }
  ],
  "sidecar": {
    "enabled": false,
    "command": "cli-proxy-api",
    "args": [],
    "ready_url": "http://127.0.0.1:8317/v1/models"
  }
}
